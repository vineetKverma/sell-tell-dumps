# Choose your Live API platform
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# For Gemini Live API (when GOOGLE_GENAI_USE_VERTEXAI=FALSE)
GOOGLE_API_KEY=<redacted>

# For Vertex AI Live API (when GOOGLE_GENAI_USE_VERTEXAI=TRUE)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=your-gcp-region

# Native-audio model required for spoken (TTS) playback of the confirmation
VOICE_NOTES_AGENT_MODEL=gemini-live-2.5-flash-native-audio

# Base URL the in-process ADK tools use to call the REST API spec endpoints.
# (The tools call /api/v1/notes/stage and /api/v1/notes/commit over HTTP, true to the spec.)
VOICE_NOTES_API_BASE=http://localhost:8000

# Silence (ms) before the model's automatic VAD finalizes a spoken turn.
# NOTE: the Live API caps this at 2000ms, so values above 2000 are clamped.
# (The spec asks for 2.5-3.0s, but 2000ms is the API maximum.)
VOICE_NOTES_VAD_SILENCE_MS=2000

# BigQuery sink: one row per committed call, written on /api/v1/notes/commit.
# Set to false to disable writes entirely (e.g. running offline).
VOICE_NOTES_BQ_ENABLED=true
# Defaults to GOOGLE_CLOUD_PROJECT above if unset -- override only if the
# dataset lives in a different project than the Vertex AI calls.
# VOICE_NOTES_BQ_PROJECT=your-gcp-project-id
VOICE_NOTES_BQ_DATASET=voice_notes_poc
VOICE_NOTES_BQ_TABLE_IMPLICIT=implicit_flow_calls
VOICE_NOTES_BQ_TABLE_GUIDED=guided_flow_calls
VOICE_NOTES_ENVIRONMENT=local_dev
