# Choose your Live API platform
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# For Gemini Live API (when GOOGLE_GENAI_USE_VERTEXAI=FALSE)
GOOGLE_API_KEY=<redacted>

# For Vertex AI Live API (when GOOGLE_GENAI_USE_VERTEXAI=TRUE)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=your-gcp-region

# Native-audio model required for spoken (TTS) playback of the confirmation
VOICE_NOTES_AGENT_MODEL=gemini-live-2.5-flash-native-audio

# Silence (ms) before the model's automatic VAD finalizes a spoken turn.
# NOTE: the Live API caps this at 2000ms, so values above 2000 are clamped.
VOICE_NOTES_VAD_SILENCE_MS=2000

# ---- BigQuery audit logging (ADK BigQueryAgentAnalyticsPlugin) ----
# Replaces the old hand-rolled bigquery_sink.py writer entirely -- no custom
# write code. Logs EVERY LLM/tool event (no event_allowlist restriction) for
# full lifecycle tracing, not just the commit event. Uses the paid BigQuery
# Storage Write API; batched, retried, never blocks or fails the live call.
BQ_ANALYTICS_DATASET_ID=voice_notes_agent_events
BQ_ANALYTICS_TABLE_ID=agent_events
BQ_ANALYTICS_LOCATION=US

BQ_ANALYTICS_ENABLED=false
